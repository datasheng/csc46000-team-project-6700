  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='Dashboard 1'>
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='49000' id='7' param='horz' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone h='49000' id='5' type-v2='layout-basic' w='82400' x='800' y='1000'>
              <zone h='37000' id='3' name='Strategy A (60/40) vs Strategy B (50/50) — $50k Initial Investment' w='82400' x='800' y='1000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='12000' id='9' type-v2='text' w='82400' x='800' y='38000'>
                <formatted-text>
                  <run bold='true' fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>A/B Test Summary</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>Difference of only $1,826 over 3 years — not statistically significant (p=0.961)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>t-statistic</run>
                  <run fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>: -0.049</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>p-value</run>
                  <run fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>: 0.961 (not significant)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>Strategy A (60/40) final</run>
                  <run fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>: $100,451.52</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>Strategy B (50/50) final:</run>
                  <run fontcolor='#8c8c8c' fontname='monospace' fontsize='8'> $102,278.00</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>Recommendation</run>
                  <run fontcolor='#8c8c8c' fontname='monospace' fontsize='8'>: 60/40 split for risk-averse retail investors</run>
                </formatted-text>
                <zone-style>
