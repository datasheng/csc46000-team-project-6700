# Copy this file to .env and fill in real values. NEVER commit .env.
# Each team member maintains their own .env locally.

# ─── API Keys ──────────────────────────────────────────
# Get a free Alpha Vantage key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# yFinance does not require a key

# ─── MySQL (Jacob's database layer) ────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=spy_qqq_allocator

# ─── FastAPI service ───────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Pipeline config ───────────────────────────────────
TICKERS=SPY,QQQ
DEFAULT_LOOKBACK_YEARS=3
